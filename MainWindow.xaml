<Window x:Class="CRUD_Do_Caos.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cadastro de Clientes - Operação Debug" Height="720" Width="1100"
 WindowStartupLocation="CenterScreen" Background="#F3F4F6">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
   <TextBlock Text="Cadastro de Clientes" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
   <TextBlock Text="Sistema interno de manutenção cadastral" Foreground="#6B7280"/>
  </StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Margin="6"><TextBlock Text="Nome"/><TextBox x:Name="txtNome" Height="32"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6"><TextBlock Text="E-mail"/><TextBox x:Name="txtEmail" Height="32"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="2" Margin="6"><TextBlock Text="Idade"/><TextBox x:Name="txtIdade" Height="32"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="3" Margin="6"><TextBlock Text="Cidade"/><TextBox x:Name="txtCidade" Height="32"/></StackPanel>
    <CheckBox x:Name="chkAtivo" Grid.Row="1" Grid.Column="0" Content="Cliente ativo" IsChecked="True" Margin="6,10"/>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="6,10,6,2">
     <Button x:Name="btnNovo" Content="Novo" Width="100" Height="36" Margin="0,0,8,0" Click="btnNovo_Click"/>
     <Button x:Name="btnSalvar" Content="Salvar" Width="100" Height="36" Margin="0,0,8,0" Click="btnSalvar_Click"/>
     <Button x:Name="btnEditar" Content="Editar" Width="100" Height="36" Margin="0,0,8,0" Click="btnEditar_Click"/>
     <Button x:Name="btnExcluir" Content="Excluir" Width="100" Height="36" Margin="0,0,8,0" Click="btnExcluir_Click"/>
     <Button x:Name="btnLimpar" Content="Limpar" Width="100" Height="36" Click="btnLimpar_Click"/>
    </StackPanel>
    <Grid Grid.Row="3" Grid.ColumnSpan="4" Margin="6,10,6,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="txtPesquisa" Height="34" VerticalContentAlignment="Center" ToolTip="Pesquise por nome, e-mail ou cidade"/>
     <Button Grid.Column="1" x:Name="btnPesquisar" Content="Pesquisar" Width="110" Margin="8,0,0,0" Click="btnPesquisar_Click"/>
    </Grid>
   </Grid>
  </Border>
  <DataGrid x:Name="dgClientes" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dgClientes_SelectionChanged" Background="White">
   <DataGrid.Columns>
    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
    <DataGridTextColumn Header="Idade" Binding="{Binding Idade}" Width="80"/>
    <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="150"/>
    <DataGridCheckBoxColumn Header="Ativo" Binding="{Binding Ativo}" Width="70"/>
   </DataGrid.Columns>
  </DataGrid>
  <Border Grid.Row="3" Background="#111827" CornerRadius="6" Padding="10" Margin="0,12,0,0">
   <TextBlock x:Name="txtStatus" Text="Pronto." Foreground="White"/>
  </Border>
 </Grid>
</Window>